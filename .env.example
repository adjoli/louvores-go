# Banco de dados
# SQLite local (usado quando TURSO_DATABASE_URL não está definida)
DB_PATH=data/hinos.db

# Turso na nuvem (opcional). Quando TURSO_DATABASE_URL está definida, a
# aplicação usa o Turso em vez do SQLite local; TURSO_AUTH_TOKEN é obrigatório.
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=seu-token-aqui

# Template PPTX usado na geração dos slides
TEMPLATE_PATH=data/templates/default.pptx

# Logs
LOG_PATH=logs/app.log

# Servidor HTTP (HOST vazio = todas as interfaces)
HOST=
PORT=8080
