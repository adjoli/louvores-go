# Configurações do Louvores-Go
# Copie este arquivo para .env e ajuste os valores conforme necessário

# ============================================
# Banco de Dados
# ============================================

# Caminho do banco SQLite local (padrão: data/hinos.db)
# Usado quando NÃO está usando Turso
DB_PATH=data/hinos.db

# ============================================
# Turso (Embedded Replica) - Produção
# ============================================
# Se TURSO_DATABASE_URL for definida, usa Embedded Replica:
# 1. Sincroniza réplica local do Turso no startup
# 2. Usa réplica local para queries (performance + offline)
# Requer: CGO_ENABLED=1

# URL do banco Turso (ex.: libsql://seu-db-sua-org.turso.io)
# TURSO_DATABASE_URL=libsql://ibrecem-adjoli.aws-us-east-2.turso.io

# Token de autenticação do Turso (gerado no painel: Database → Settings → Auth Tokens)
# Deve ter escopo no database específico (não org-level)
# TURSO_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Template PPTX
# ============================================

# Caminho do template PPTX para geração de slides
TEMPLATE_PATH=data/templates/default.pptx

# ============================================
# Logging
# ============================================

# Arquivo de log (padrão: logs/app.log)
LOG_PATH=logs/app.log

# ============================================
# Servidor HTTP
# ============================================

# Host de escuta (vazio = todas as interfaces)
# HOST=

# Porta do servidor HTTP (padrão: 8080)
PORT=8080
