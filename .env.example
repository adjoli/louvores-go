# Banco de dados
# SQLite local (usado quando TURSO_DATABASE_URL não está definida)
DB_PATH=data/hinos.db

# Turso na nuvem (opcional). Quando TURSO_DATABASE_URL está definida, a
# aplicação usa o Turso em vez do SQLite local; TURSO_AUTH_TOKEN é obrigatório.
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=seu-token-aqui

# Template PPTX usado na geração dos slides
TEMPLATE_PATH=data/templates/default.pptx

# Logs
LOG_PATH=logs/app.log

# Servidor HTTP (HOST vazio = todas as interfaces)
HOST=
PORT=8080

# Autenticação (senha única compartilhada + sessão por cookie assinado).
# AUTH_PASSWORD vazia desliga a autenticação (adequado apenas em dev local).
AUTH_PASSWORD=

# Chave HMAC que assina o cookie de sessão. Vazia gera uma chave aleatória em
# runtime (as sessões caem a cada restart). Defina em produção.
SESSION_SECRET=

# Marque true quando a aplicação estiver atrás de HTTPS (cookie Secure).
COOKIE_SECURE=false

# Duração da sessão (formato Go: 30m, 12h, 24h).
SESSION_TTL=24h
