// novo.templ — formulário de criação de um hino novo.
//
// Serve em /web/hinos/{codigo}/novo e só existe para a coletânea Corinhos
// (a rota responde 404 nas demais). O formulário envia POST para
// /web/hinos/{codigo}. A numeração é calculada automaticamente pela camada de
// serviço (maior existente + 1) e por isso não é um campo editável.
package templates

import (
	"fmt"
)

// NovoHinoPage renderiza a página com o formulário de criação de um hino,
// exibindo a coletânea como informação. version é exibida no rodapé.
templ NovoHinoPage(codigo string, version string, autenticado bool) {
	@Layout("Adicionar Hino · Louvores", version, autenticado, novoForm(codigo))
}

// novoForm monta o formulário de criação. A submissão via POST vai para
// /web/hinos/{codigo}, criando o hino com a próxima numeração disponível.
templ novoForm(codigo string) {
	<h1 class="mb-6 text-2xl font-bold text-slate-800">Adicionar Hino</h1>

	<p class="mb-4 text-sm text-slate-600">
		Coletânea: <span class="font-semibold">{ codigo }</span>
		· Número: <span class="font-semibold">automático (último + 1)</span>
	</p>

	<form
		class="max-w-2xl space-y-4"
		method="post"
		action={ fmt.Sprintf("/web/hinos/%s", codigo) }
	>
		<div>
			<label for="titulo" class="mb-1 block text-sm font-medium text-slate-700">Título</label>
			<input
				id="titulo"
				name="titulo"
				type="text"
				required
				class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none"
			>
		</div>

		<div>
			<label for="letra" class="mb-1 block text-sm font-medium text-slate-700">Letra</label>
			<textarea
				id="letra"
				name="letra"
				rows="12"
				class="w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm shadow-sm focus:border-indigo-500 focus:outline-none"
			></textarea>
		</div>

		<div>
			<label for="creditos" class="mb-1 block text-sm font-medium text-slate-700">Créditos</label>
			<input
				id="creditos"
				name="creditos"
				type="text"
				class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none"
			>
		</div>

		<div class="flex items-center gap-2">
			<input
				id="revisado"
				name="revisado"
				type="checkbox"
				class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
			>
			<label for="revisado" class="text-sm text-slate-700">Revisado</label>
		</div>

		<div class="flex items-center gap-3 pt-2">
			<button
				type="submit"
				class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700"
			>
				Adicionar
			</button>
			<a href="/slides" class="text-sm text-slate-600 hover:text-indigo-700">Cancelar</a>
		</div>
	</form>
}
